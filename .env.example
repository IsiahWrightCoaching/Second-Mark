# Set automatically by the Vercel–Supabase integration. For local development, copy to .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The publishable (anon) key. Safe in the browser because row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never add the service role / secret key here or in any NEXT_PUBLIC_ variable.
